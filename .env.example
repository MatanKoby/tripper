# Tripper backend config. Copy to .env for local dev (.env is gitignored).
# Backend-only; the frontend uses VITE_FIREBASE_* in Vercel, not these.

# --- Firebase / GCP ---
GCP_PROJECT=your-firebase-project-id
# Local dev against the emulator (leave unset in the cloud):
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Agent selection (passed through to the hotel agent) ---
ENABLED_PROVIDERS=mock        # mock | liteapi | mock,liteapi
SCORER=heuristic              # heuristic | llm
LLM_BACKEND=auto              # auto | openai | endpoint

# --- Nebius Ollama serverless endpoint (no key) ---
NEBIUS_ENDPOINT_URL=
NEBIUS_ENDPOINT_TOKEN=
NEBIUS_ENDPOINT_MODEL=
# NEBIUS_ENDPOINT_ID enables the serverless dedicated-endpoint path in the flight + activities
# agents (the hotel agent has no such field). Leave blank to run those agents keyless.
NEBIUS_ENDPOINT_ID=

# --- Nebius per-token OpenAI-compatible API (activities agent LLM) ---
# Set both to run the activities agent against a real LLM; blank = keyless mock recommendations.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=

# --- OpenAI-compatible LLM (key path; alternative to the endpoint above) ---
LLM_BASE_URL=
LLM_API_KEY=

# --- LiteAPI hotel data (required only when 'liteapi' is enabled) ---
LITEAPI_API_KEY=
