{
  "functions": {
    "source": ".",
    "runtime": "python312",
    "ignore": [
      "venv",
      ".venv",
      ".git",
      ".github",
      ".claude",
      "node_modules",
      "web",
      "tests",
      "**/__pycache__",
      "*-debug.log"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
