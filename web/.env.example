# Tripper frontend config. Copy to .env.local for local dev (.env.local is gitignored).
# In production these are set as Vercel env vars (Batch 1). Vite only exposes vars
# prefixed with VITE_ to the client bundle.

# --- Firebase web config (Project settings > Your apps > SDK setup) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# --- Local dev against the Firebase emulators (leave unset / "false" in the cloud) ---
# When "true", the app connects Auth to localhost:9099 and Firestore to localhost:8080
# (ports from the repo-root firebase.json). Run `firebase emulators:start` alongside `npm run dev`.
VITE_USE_EMULATOR=false
